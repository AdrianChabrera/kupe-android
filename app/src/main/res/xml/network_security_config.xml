<?xml version="1.0" encoding="utf-8"?>
<!-- Release: HTTPS only, system CAs only. User-installed CAs are NOT trusted. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- TODO (when the production domain exists): pin its certificate here.
