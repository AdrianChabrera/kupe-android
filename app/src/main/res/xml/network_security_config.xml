        <domain includeSubdomains="false">api.kupe.example</domain>
        <pin-set expiration="2027-12-31">
            <pin digest="SHA-256">BASE64_SPKI_HASH_PRIMARY=</pin>
            <pin digest="SHA-256">BASE64_SPKI_HASH_BACKUP=</pin>
        </pin-set>
    </domain-config>
    -->
</network-security-config>
